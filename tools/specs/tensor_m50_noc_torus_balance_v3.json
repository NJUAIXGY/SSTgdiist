{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 2,
    "stop": { "mode": "time", "simulation_time": "30us" }
  },
  "noc": {
    "type": "merlin_torus",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2, "shape": "2x2" }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "80ns" }
  },
  "pe": { "cores_per_pe": 1, "neurons_per_core": 1 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_capability_profile": "noc_fidelity_v2",
      "tensor_scheduler_model": "legacy",
      "tensor_memory_hierarchy_profile": "balanced",
      "tensor_exec_mode": "program",
      "tensor_iterations": 1,
      "tensor_mem_enable": 1,
      "tensor_mem_req_bytes": 64,
      "tensor_mem_max_outstanding": 64,
      "tensor_dma_bandwidth_bytes_per_cycle": 256,
      "tensor_collective_type": "allreduce",
      "tensor_collective_blocking": 1,
      "tensor_collective_scope": "per_system",
      "tensor_collective_algo": "torus_2d_rs_ag",
      "tensor_collective_2d_dim_x": 2,
      "tensor_collective_2d_dim_y": 2,
      "tensor_collective_chunk_bytes": 4096,
      "tensor_collective_packet_bytes": 256,
      "tensor_collective_max_inflight_chunks": 8,
      "tensor_collective_credit_enable": 1,
      "tensor_collective_credit_window_chunks": 8,
      "tensor_collective_backpressure_mode": "soft",
      "tensor_noc_bandwidth_bytes_per_cycle": 0
    },
    "program": {
      "loop": false,
      "ops": [
        { "op_type": "dma_read", "bytes": 8192 },
        { "op_type": "gemm_ub", "cycles": 128, "ub_read_bytes": 4096, "ub_write_bytes": 2048 },
        { "op_type": "allreduce", "bytes": 65536, "blocking": true },
        { "op_type": "fence" }
      ]
    }
  }
}
