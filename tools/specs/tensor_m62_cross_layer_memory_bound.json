{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 2,
    "stop": { "mode": "time", "simulation_time": "35us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "30GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "120ns" }
  },
  "pe": { "cores_per_pe": 1, "neurons_per_core": 1 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_capability_profile": "cross_layer_v1",
      "tensor_scheduler_model": "attribution_v1",
      "tensor_memory_hierarchy_profile": "edge",
      "tensor_exec_mode": "program",
      "tensor_iterations": 1,
      "tensor_mem_enable": 1,
      "tensor_mem_req_bytes": 64,
      "tensor_mem_max_outstanding": 8,
      "tensor_dma_bandwidth_bytes_per_cycle": 48,
      "tensor_program_issue_width": 2,
      "tensor_mem_timing_model": "proxy_v3",
      "tensor_mem_bank_groups_per_channel": 2,
      "tensor_mem_banks_per_group": 2,
      "tensor_mem_row_bytes": 512,
      "tensor_mem_bank_queue_depth": 2,
      "tensor_mem_sched_policy": "fifo",
      "tensor_mem_t_rcd_cycles": 18,
      "tensor_mem_t_cl_cycles": 14,
      "tensor_mem_t_rp_cycles": 18,
      "tensor_mem_t_burst_cycles": 6,
      "tensor_mem_t_ccd_s_cycles": 6,
      "tensor_mem_t_ccd_l_cycles": 12,
      "tensor_collective_type": "none"
    },
    "program": {
      "loop": false,
      "ops": [
        { "op_type": "dma_read", "bytes": 262144 },
        { "op_type": "fence" },
        { "op_type": "gemm_ub", "cycles": 300, "ub_read_bytes": 16384, "ub_write_bytes": 8192 },
        { "op_type": "fence" },
        { "op_type": "dma_read", "bytes": 262144 },
        { "op_type": "fence" },
        { "op_type": "gemm_ub", "cycles": 300, "ub_read_bytes": 16384, "ub_write_bytes": 8192 },
        { "op_type": "fence" }
      ]
    }
  }
}
