{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 2,
    "stop": { "mode": "time", "simulation_time": "20us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "100ns" }
  },
  "pe": { "cores_per_pe": 4, "neurons_per_core": 4 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_iterations": 1,
      "tensor_collective_type": "allreduce",
      "tensor_collective_blocking": 0,
      "tensor_collective_scope": "per_core",
      "tensor_collective_packet_bytes": 256,
      "tensor_collective_algo": "ring_chunked",
      "tensor_collective_chunk_bytes": 4096,
      "tensor_collective_max_inflight_chunks": 8,
      "tensor_collective_credit_enable": 1,
      "tensor_collective_credit_window_chunks": 1,
      "tensor_collective_credit_return_mode": "event_on_recv",
      "tensor_collective_backpressure_mode": "hard"
    },
    "program": { "loop": false, "ops": [{ "op_type": "allreduce", "bytes": 32768, "blocking": false }] }
  }
}

