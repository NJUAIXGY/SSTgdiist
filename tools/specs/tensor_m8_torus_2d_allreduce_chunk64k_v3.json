{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 4,
    "stop": { "mode": "time", "simulation_time": "50us" }
  },
  "noc": {
    "type": "merlin_torus",
    "params": {
      "shape": "2x8",
      "link_bw": "40GiB/s",
      "buffer_size": "8KiB",
      "num_vns": 2
    }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "100ns" }
  },
  "pe": { "cores_per_pe": 4, "neurons_per_core": 4 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_iterations": 1,
      "tensor_collective_type": "allreduce",
      "tensor_collective_blocking": 1,
      "tensor_collective_scope": "per_system",
      "tensor_collective_packet_bytes": 256,
      "tensor_collective_algo": "torus_2d_rs_ag",
      "tensor_collective_chunk_bytes": 65536,
      "tensor_collective_reduce_overhead_cycles": 8,
      "tensor_collective_max_inflight_chunks": 1,
      "tensor_collective_credit_enable": 1,
      "tensor_collective_credit_window_chunks": 0,
      "tensor_collective_credit_return_mode": "legacy_tick"
    },
    "program": { "loop": false, "ops": [{ "op_type": "allreduce", "bytes": 65536, "blocking": true }] }
  }
}
