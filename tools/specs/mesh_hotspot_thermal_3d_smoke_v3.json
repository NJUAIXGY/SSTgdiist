{
  "schema_version": 3,
  "model": "mesh",
  "platform": {
    "mesh_size": 4,
    "exec_mode": "gas",
    "stop": {
      "mode": "step_limited",
      "max_steps": 1
    }
  },
  "pe": {
    "cores_per_pe": 1,
    "neurons_per_core": 4
  },
  "workload": {
    "type": "snn"
  },
  "loader": {
    "chunk_bytes": 65536
  },
  "step": {
    "random_activation_enable": 1,
    "activation_fraction": 0.01,
    "activation_fanout": 8,
    "activation_trigger_core": 0
  },
  "validate": {
    "profile": "dev"
  },
  "thermal": {
    "enable": true,
    "backend": "hotspot",
    "model_type": "grid",
    "grid_rows": 64,
    "grid_cols": 64,
    "grid_map_mode": "avg",
    "detailed_3d": true,
    "window_ns": 1000,
    "out_dir": "thermal",
    "tile_width_um": 1000,
    "tile_height_um": 1000,
    "tile_gap_um": 50,
    "comp_frac": 0.6,
    "sram_frac": 0.25,
    "noc_frac": 0.15,
    "layers": [
      {
        "name": "compute_top",
        "kind": "mesh_active",
        "z_um": 0,
        "thickness_um": 150
      },
      {
        "name": "tim_mid",
        "kind": "tim",
        "z_um": 150,
        "thickness_um": 20
      },
      {
        "name": "compute_bottom",
        "kind": "mesh_active",
        "z_um": 170,
        "thickness_um": 150,
        "power_scale": 0.5
      }
    ]
  }
}
