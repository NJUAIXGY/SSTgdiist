{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 1,
    "stop": { "mode": "time", "simulation_time": "10us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "1ns" }
  },
  "pe": { "cores_per_pe": 1, "neurons_per_core": 1 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_exec_mode": "program",
      "tensor_iterations": 1,
      "tensor_mem_enable": 1,
      "tensor_mem_req_bytes": 64,
      "tensor_mem_max_outstanding": 256,
      "tensor_dma_bandwidth_bytes_per_cycle": 4096,
      "tensor_ub_bytes": 8192,
      "tensor_program_issue_width": 4,
      "tensor_onchip_model_enable": 1,
      "tensor_onchip_bank_model_enable": 1,
      "tensor_ub_bank_count": 1,
      "tensor_ub_bank_conflict_mode": "queue",
      "tensor_bank_queue_depth": 2,
      "tensor_ub_read_ports": 1024,
      "tensor_ub_write_ports": 1024
    },
    "program": {
      "loop": false,
      "ops": [
        { "op_type": "dma_read", "bytes": 8192, "reset": true },
        { "op_type": "gemm_ub", "cycles": 32, "ub_read_bytes": 0, "ub_write_bytes": 0 },
        { "op_type": "fence" }
      ]
    }
  }
}
