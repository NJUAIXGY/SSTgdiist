{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 1,
    "stop": { "mode": "time", "simulation_time": "50us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "1ns" }
  },
  "pe": { "cores_per_pe": 1, "neurons_per_core": 1 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_exec_mode": "program",
      "tensor_iterations": 1,
      "tensor_mem_enable": 1,
      "tensor_mem_req_bytes": 64,
      "tensor_mem_max_outstanding": 4096,

      "tensor_dma_burst_bytes": 4096,
      "tensor_dma_setup_cycles": 0,
      "tensor_dma_read_engines": 4,
      "tensor_dma_write_engines": 4,
      "tensor_dma_max_inflight_per_engine": 16,

      "tensor_ub_bytes": 65536,
      "tensor_program_issue_width": 4
    },
    "program": {
      "loop": false,
      "ops": [
        { "op_type": "dma_read", "bytes": 65536, "reset": true },
        { "op_type": "fence" },
        { "op_type": "gemm_ub", "cycles": 1, "ub_read_bytes": 0, "ub_write_bytes": 0 }
      ]
    }
  }
}
