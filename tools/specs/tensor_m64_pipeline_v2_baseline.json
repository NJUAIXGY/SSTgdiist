{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 2,
    "stop": { "mode": "time", "simulation_time": "30us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "60ns" }
  },
  "pe": { "cores_per_pe": 1, "neurons_per_core": 1 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_capability_profile": "pipeline_v2",
      "tensor_scheduler_model": "pipeline_v2",
      "tensor_memory_hierarchy_profile": "balanced",
      "tensor_exec_mode": "program",
      "tensor_iterations": 1,
      "tensor_mem_enable": 1,
      "tensor_mem_req_bytes": 64,
      "tensor_mem_max_outstanding": 128,
      "tensor_dma_bandwidth_bytes_per_cycle": 256,
      "tensor_program_issue_width": 4,
      "tensor_compute_pipeline_latency_cycles": 1,
      "tensor_mxu_wavefront_enable": 0,
      "tensor_program_dma_dual_enable": 1,
      "tensor_program_engine_priority": "dma>mxu>vec>coll"
    },
    "program": {
      "loop": false,
      "ops": [
        { "op_type": "dma_read", "bytes": 65536 },
        { "op_type": "gemm_ub", "cycles": 192, "ub_read_bytes": 8192, "ub_write_bytes": 4096 },
        { "op_type": "dma_write", "bytes": 8192 },
        { "op_type": "fence" },
        { "op_type": "dma_read", "bytes": 65536 },
        { "op_type": "gemm_ub", "cycles": 192, "ub_read_bytes": 8192, "ub_write_bytes": 4096 },
        { "op_type": "dma_write", "bytes": 8192 },
        { "op_type": "fence" }
      ]
    }
  }
}
