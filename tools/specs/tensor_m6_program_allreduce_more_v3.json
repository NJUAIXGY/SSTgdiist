{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 2,
    "stop": { "mode": "time", "simulation_time": "5us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "100ns" }
  },
  "pe": { "cores_per_pe": 4, "neurons_per_core": 4 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_m": 64,
      "tensor_n": 64,
      "tensor_k": 64,
      "tensor_exec_mode": "program",
      "tensor_iterations": 1,
      "tensor_tile_m": 32,
      "tensor_tile_n": 32,
      "tensor_tile_k": 32,
      "tensor_ub_bytes": 32768,
      "tensor_dma_bandwidth_bytes_per_cycle": 256,
      "tensor_noc_bandwidth_bytes_per_cycle": 256,
      "tensor_collective_type": "allreduce",
      "tensor_collective_algo": "ring_chunked",
      "tensor_collective_period_cycles": 0,
      "tensor_collective_bytes": 0,
      "tensor_collective_packet_bytes": 64,
      "tensor_collective_chunk_bytes": 256,
      "tensor_collective_max_inflight_chunks": 2,
      "tensor_collective_credit_enable": 0,
      "tensor_collective_blocking": 0,
      "tensor_vector_elems_per_cycle": 64,
      "tensor_vector_pipeline_latency_cycles": 0
    },
    "program": {
      "loop": false,
      "ops": [
        { "op_type": "gemm" },
        { "op_type": "allreduce", "bytes": 40960, "blocking": false },
        { "op_type": "softmax", "elems": 4096 }
      ]
    }
  }
}
