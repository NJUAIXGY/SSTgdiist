{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 1,
    "stop": { "mode": "time", "simulation_time": "20us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "50ns" }
  },
  "pe": { "cores_per_pe": 1, "neurons_per_core": 1 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_capability_profile": "readiness_evidence_v2",
      "tensor_scheduler_model": "legacy",
      "tensor_memory_hierarchy_profile": "baseline",
      "tensor_m": 64,
      "tensor_n": 64,
      "tensor_k": 64,
      "tensor_exec_mode": "program",
      "tensor_iterations": 1,
      "tensor_tile_m": 32,
      "tensor_tile_n": 32,
      "tensor_tile_k": 32,
      "tensor_ub_bytes": 32768,
      "tensor_mem_enable": 1,
      "tensor_program_issue_width": 4,
      "tensor_mem_req_bytes": 64,
      "tensor_mem_max_outstanding": 64,
      "tensor_dma_bandwidth_bytes_per_cycle": 256,
      "tensor_mem_timing_model": "off"
    },
    "program": {
      "loop": false,
      "ops": [
        { "op_type": "gemm" }
      ]
    }
  }
}
