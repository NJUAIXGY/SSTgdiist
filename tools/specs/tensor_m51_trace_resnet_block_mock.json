{
  "schema_version": 1,
  "name": "resnet_block_mock",
  "platform": {
    "mesh_size": 2,
    "simulation_time": "25us"
  },
  "noc": {
    "type": "merlin_mesh",
    "link_bw": "40GiB/s",
    "buffer_size": "8KiB",
    "num_vns": 2
  },
  "memory": {
    "backend": "simple",
    "core_mem_region_bytes": 1048576,
    "mem_access_time": "80ns"
  },
  "tensor_params": {
    "tensor_capability_profile": "trace_bridge_v1",
    "tensor_scheduler_model": "trace_replay",
    "tensor_memory_hierarchy_profile": "balanced",
    "tensor_exec_mode": "program",
    "tensor_program_issue_width": 4,
    "tensor_mem_req_bytes": 64,
    "tensor_mem_max_outstanding": 64
  },
  "program": [
    { "op": "dma_read", "bytes": 8192 },
    { "op": "dma_read", "bytes": 8192 },
    { "op": "gemm_ub", "cycles": 192, "ub_read_bytes": 16384, "ub_write_bytes": 8192 },
    { "op": "dma_write", "bytes": 8192 },
    { "op": "allreduce", "bytes": 8192, "blocking": true },
    { "op": "fence" }
  ]
}
