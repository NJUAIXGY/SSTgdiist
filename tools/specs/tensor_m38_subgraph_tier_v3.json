{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 2,
    "stop": { "mode": "time", "simulation_time": "50us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "100ns" }
  },
  "pe": { "cores_per_pe": 4, "neurons_per_core": 4 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_capability_profile": "subgraph_tier",
      "tensor_scheduler_model": "legacy",
      "tensor_memory_hierarchy_profile": "balanced",
      "tensor_m": 64,
      "tensor_n": 64,
      "tensor_k": 64,
      "tensor_element_bytes": 2,
      "tensor_array_m": 32,
      "tensor_array_n": 32,
      "tensor_compute_precision": "fp16",
      "tensor_iterations": 1,
      "tensor_mem_req_bytes": 64,
      "tensor_mem_max_outstanding": 128,
      "tensor_tile_m": 32,
      "tensor_tile_n": 32,
      "tensor_tile_k": 32,
      "tensor_ub_bytes": 32768,
      "tensor_dma_bandwidth_bytes_per_cycle": 256,
      "tensor_collective_type": "allreduce",
      "tensor_collective_blocking": 1,
      "tensor_collective_scope": "per_system",
      "tensor_collective_packet_bytes": 256,
      "tensor_collective_algo": "ring_chunked",
      "tensor_collective_chunk_bytes": 4096,
      "tensor_collective_reduce_overhead_cycles": 0,
      "tensor_collective_max_inflight_chunks": 4,
      "tensor_collective_credit_enable": 0
    },
    "program": {
      "loop": false,
      "ops": [
        { "op_type": "dma_read", "bytes": 8192 },
        { "op_type": "gemm_ub", "cycles": 128, "ub_read_bytes": 8192, "ub_write_bytes": 4096 },
        { "op_type": "dma_write", "bytes": 4096 },
        { "op_type": "fence" },
        { "op_type": "allreduce", "bytes": 4096, "blocking": true }
      ]
    }
  }
}
