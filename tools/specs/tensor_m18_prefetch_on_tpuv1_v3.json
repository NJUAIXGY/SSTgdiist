{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 1,
    "stop": { "mode": "time", "simulation_time": "50us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "1ns" }
  },
  "pe": { "cores_per_pe": 4, "neurons_per_core": 4 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_exec_mode": "program",
      "tensor_iterations": 1,
      "tensor_mem_enable": 1,
      "tensor_mem_req_bytes": 256,
      "tensor_mem_max_outstanding": 32,
      "tensor_dma_bandwidth_bytes_per_cycle": 256,
      "tensor_ub_bytes": 32768,
      "tensor_program_issue_width": 4,
      "tensor_program_ub_buffers": 2,
      "tensor_array_m": 256,
      "tensor_array_n": 256,
      "tensor_compute_precision": "int8"
    },
    "program": {
      "loop": false,
      "ops": [
        { "op_type": "dma_read", "bytes": 8192, "buf": 0, "reset": true },
        { "op_type": "gemm_ub", "cycles": 128, "ub_read_bytes": 8192, "ub_write_bytes": 2048, "buf": 0 },
        { "op_type": "dma_read", "bytes": 8192, "buf": 1, "reset": true },
        { "op_type": "dma_write", "bytes": 2048, "buf": 0, "consume": true },
        { "op_type": "gemm_ub", "cycles": 128, "ub_read_bytes": 8192, "ub_write_bytes": 2048, "buf": 1 },
        { "op_type": "dma_write", "bytes": 2048, "buf": 1, "consume": true },
        { "op_type": "fence" }
      ]
    }
  }
}

