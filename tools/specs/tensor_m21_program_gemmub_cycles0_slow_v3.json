{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 1,
    "stop": { "mode": "time", "simulation_time": "50us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "100ns" }
  },
  "pe": { "cores_per_pe": 1, "neurons_per_core": 1 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_exec_mode": "program",
      "tensor_iterations": 1,
      "tensor_program_issue_width": 4,
      "tensor_compute_precision": "fp16",
      "tensor_compute_profile_override_enable": 1,
      "tensor_compute_throughput_scale": 0.25,
      "tensor_array_m": 64,
      "tensor_array_n": 64
    },
    "program": {
      "loop": false,
      "ops": [
        {
          "op_type": "gemm_ub",
          "cycles": 0,
          "ub_read_bytes": 0,
          "ub_write_bytes": 0,
          "m": 256,
          "n": 256,
          "k": 256
        },
        { "op_type": "fence" }
      ]
    }
  }
}

