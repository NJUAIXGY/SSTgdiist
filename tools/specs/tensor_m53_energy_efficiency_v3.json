{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 1,
    "stop": { "mode": "time", "simulation_time": "25us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "40ns" }
  },
  "pe": { "cores_per_pe": 1, "neurons_per_core": 1 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_capability_profile": "energy_ras_v1",
      "tensor_scheduler_model": "efficient",
      "tensor_memory_hierarchy_profile": "server",
      "tensor_exec_mode": "program",
      "tensor_iterations": 1,
      "tensor_mem_enable": 1,
      "tensor_mem_req_bytes": 128,
      "tensor_mem_max_outstanding": 128,
      "tensor_dma_bandwidth_bytes_per_cycle": 512,
      "tensor_program_issue_width": 4,
      "tensor_collective_type": "none"
    },
    "program": {
      "loop": false,
      "ops": [
        { "op_type": "dma_read", "bytes": 16384 },
        { "op_type": "gemm_ub", "cycles": 256, "ub_read_bytes": 16384, "ub_write_bytes": 8192 },
        { "op_type": "dma_write", "bytes": 8192 },
        { "op_type": "fence" }
      ]
    }
  }
}
