{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 4,
    "stop": {
      "mode": "time",
      "simulation_time": "5us"
    }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": {
      "link_bw": "40GiB/s",
      "buffer_size": "8KiB",
      "num_vns": 2
    }
  },
  "memory": {
    "type": "shared",
    "backend": {
      "type": "simple"
    },
    "params": {
      "core_mem_region_bytes": 1048576,
      "mem_access_time": "100ns"
    }
  },
  "pe": {
    "cores_per_pe": 4,
    "neurons_per_core": 4
  },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_m": 256,
      "tensor_n": 256,
      "tensor_k": 256,
      "tensor_exec_mode": "tile",
      "tensor_tile_m": 64,
      "tensor_tile_n": 64,
      "tensor_tile_k": 64,
      "tensor_overlap_enable": 1,
      "tensor_double_buffer": 1,
      "tensor_ub_bytes": 24576,
      "tensor_acc_bytes": 8192,
      "tensor_onchip_model_enable": 1,
      "tensor_ub_bank_bytes": 8192,
      "tensor_ub_read_ports": 2,
      "tensor_ub_write_ports": 8,
      "tensor_acc_bank_bytes": 8192,
      "tensor_acc_read_ports": 2,
      "tensor_acc_write_ports": 2,
      "tensor_spill_enable": 0,
      "tensor_dma_bandwidth_bytes_per_cycle": 1024,
      "tensor_collective_type": "none",
      "tensor_noc_bandwidth_bytes_per_cycle": 64,
      "tensor_array_m": 8,
      "tensor_array_n": 8,
      "tensor_mem_req_bytes": 256,
      "tensor_mem_max_outstanding": 128
    }
  }
}
