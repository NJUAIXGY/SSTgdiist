{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 4,
    "stop": { "mode": "time", "simulation_time": "5us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "100ns" }
  },
  "pe": { "cores_per_pe": 4, "neurons_per_core": 4 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_m": 256,
      "tensor_n": 256,
      "tensor_k": 256,
      "tensor_exec_mode": "tile",
      "tensor_tile_m": 64,
      "tensor_tile_n": 64,
      "tensor_tile_k": 64,
      "tensor_ub_bytes": 65536,
      "tensor_dma_bandwidth_bytes_per_cycle": 256,
      "tensor_collective_type": "allreduce",
      "tensor_collective_scope": "per_core",
      "tensor_collective_blocking": 0,
      "tensor_collective_bytes": 1048576,
      "tensor_collective_period_cycles": 1,
      "tensor_collective_pattern": "ring",
      "tensor_collective_packet_bytes": 64,
      "tensor_collective_algo": "ring_chunked",
      "tensor_collective_chunk_bytes": 1024,
      "tensor_collective_reduce_overhead_cycles": 0,
      "tensor_collective_max_inflight_chunks": 4,
      "tensor_collective_credit_enable": 1,
      "tensor_collective_credit_window_chunks": 1,
      "tensor_collective_credit_return_mode": "event_on_recv",
      "tensor_collective_backpressure_mode": "hard",
      "tensor_noc_bandwidth_bytes_per_cycle": 64,
      "tensor_collective_overlap_with_compute": 1,
      "tensor_collective_issue_priority": "payload_first",
      "tensor_comm_enable": 1,
      "tensor_comm_period_cycles": 1,
      "tensor_comm_payload_bytes": 64
    }
  }
}
