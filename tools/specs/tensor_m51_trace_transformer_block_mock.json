{
  "schema_version": 1,
  "name": "transformer_block_mock",
  "platform": {
    "mesh_size": 2,
    "simulation_time": "30us"
  },
  "noc": {
    "type": "merlin_mesh",
    "link_bw": "40GiB/s",
    "buffer_size": "8KiB",
    "num_vns": 2
  },
  "memory": {
    "backend": "simple",
    "core_mem_region_bytes": 1048576,
    "mem_access_time": "90ns"
  },
  "tensor_params": {
    "tensor_capability_profile": "trace_bridge_v1",
    "tensor_scheduler_model": "trace_replay",
    "tensor_memory_hierarchy_profile": "server",
    "tensor_exec_mode": "program",
    "tensor_program_issue_width": 2,
    "tensor_mem_req_bytes": 128,
    "tensor_mem_max_outstanding": 128
  },
  "program": [
    { "op": "dma_read", "bytes": 12288 },
    { "op": "gemm_ub", "cycles": 256, "ub_read_bytes": 12288, "ub_write_bytes": 4096 },
    { "op": "softmax", "elems": 2048 },
    { "op": "dma_write", "bytes": 4096 },
    { "op": "allreduce", "bytes": 4096, "blocking": true },
    { "op": "fence" }
  ]
}
