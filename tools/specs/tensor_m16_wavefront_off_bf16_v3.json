{
  "schema_version": 3,
  "model": "tensor",
  "platform": {
    "mesh_size": 1,
    "stop": { "mode": "time", "simulation_time": "50us" }
  },
  "noc": {
    "type": "merlin_mesh",
    "params": { "link_bw": "40GiB/s", "buffer_size": "8KiB", "num_vns": 2 }
  },
  "memory": {
    "type": "shared",
    "backend": { "type": "simple" },
    "params": { "core_mem_region_bytes": 1048576, "mem_access_time": "1ns" }
  },
  "pe": { "cores_per_pe": 4, "neurons_per_core": 4 },
  "workload": {
    "type": "tensor",
    "stats_modules": "tensor",
    "params": {
      "tensor_exec_mode": "tile",
      "tensor_iterations": 1,
      "tensor_mem_enable": 0,
      "tensor_m": 256,
      "tensor_n": 256,
      "tensor_k": 256,
      "tensor_element_bytes": 2,
      "tensor_array_m": 32,
      "tensor_array_n": 32,
      "tensor_compute_precision": "bf16",
      "tensor_tile_m": 64,
      "tensor_tile_n": 64,
      "tensor_tile_k": 64,
      "tensor_tile_schedule": "mnk",
      "tensor_mxu_wavefront_enable": 0,
      "tensor_mxu_wavefront_alpha": 1.0
    }
  }
}

