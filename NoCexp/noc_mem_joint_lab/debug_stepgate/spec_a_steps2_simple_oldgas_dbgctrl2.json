{
  "schema_version": 3,
  "model": "mesh",
  "platform": {
    "mesh_size": 4,
    "exec_mode": "gas",
    "stop": {
      "mode": "step_limited",
      "max_steps": 2
    }
  },
  "workload": {
    "type": "snn"
  },
  "loader": {
    "chunk_bytes": 65536
  },
  "pe": {
    "num_cores_per_pe": 20,
    "neurons_per_core": 500,
    "core": {
      "apply_dense_acc_enable": true,
      "memory_warmup_cycles": 200,
      "loader_barrier_cycles": 0
    }
  },
  "memory": {
    "type": "memHierarchy",
    "backend": {
      "type": "simple",
      "access_time": "100ns"
    }
  },
  "gas": {
    "merge_policy": "cacheline",
    "gap_k_bytes": 2048,
    "row_window_bytes": 16384,
    "row_window_timeout_ns": 0,
    "force_defer": true,
    "max_inflight": 128,
    "apply_bank_credit": 1,
    "window_cycles": {
      "gather": 200,
      "apply": 40,
      "scatter": 40
    }
  },
  "step": {
    "random_activation_enable": 1,
    "activation_fraction": 0.0002,
    "activation_fanout": 256,
    "activation_seed": 271828,
    "activation_use_bcsr_routes": true
  },
  "components": {
    "global_step_controller": {
      "verbose": 2,
      "experimental_progress_enable": 1,
      "experimental_progress_period_cycles": 50000,
      "experimental_progress_max_reports": 100
    },
    "pe.core": {
      "window_read_enable": 1,
      "window_read_budget": 8192,
      "experimental_noc_rowidx_prefetch_enable": 0,
      "experimental_noc_rowidx_prefetch_budget_per_tick": 4,
      "experimental_noc_rowidx_cache_rows": 1024,
      "experimental_noc_rowidx_prefetch_gather_only": 1,
      "experimental_noc_rowidx_hot_touch_min": 1,
      "experimental_noc_rowidx_budget_adapt_enable": 0,
      "experimental_noc_rowidx_budget_adapt_max_per_tick": 32,
      "experimental_noc_rowidx_budget_adapt_q_depth": 16
    }
  }
}

